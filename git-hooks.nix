{
  pkgs,
  # The Go that go.mod asks for, so gofmt agrees with the compiler in use
  go,
  # The script behind `nix run .#vendor-hash`
  vendor-hash,
}: {
  src = ./.;
  package = pkgs.prek;

  # The only Rust crate is the blueprint renderer
  settings.rust.cargoManifestPath = "viz/Cargo.toml";

  hooks = {
    # Nix
    alejandra.enable = true;
    deadnix.enable = true;
    statix.enable = true;

    # Go
    gofmt = {
      enable = true;
      package = go;
    };

    # Rust
    rustfmt = {
      enable = true;
      packageOverrides = {inherit (pkgs) cargo rustfmt;};
    };
    clippy = {
      enable = true;
      packageOverrides = {inherit (pkgs) cargo clippy;};
      settings = {
        denyWarnings = true;
        extraArgs = "--all-targets";
      };
    };

    # Web UI, e2e suite, Markdown, YAML and JSON
    prettier = {
      enable = true;
      package = pkgs.prettier;
      excludes = [
        "package-lock\\.json$"
        "^flake\\.lock$"
        "^web/dist/"
        # Generated by `npm run icons`
        "^web/src/lib/icons\\.ts$"
        # Test data stays byte-identical to what the scanners and the renderer emit
        "^internal/ingest/testdata/"
        "^viz/fixtures/"
        "^viz/demo/.*\\.json$"
      ];
    };

    # package.nix pins the Go modules with one hash that changes with go.sum. Needs the
    # network, so `nix flake check` leaves it out; there the package build checks the hash.
    vendor-hash = {
      enable = true;
      name = "vendor-hash";
      description = "Refresh vendorHash in package.nix when go.mod or go.sum change.";
      entry = pkgs.lib.getExe vendor-hash;
      files = "^go\\.(mod|sum)$";
      pass_filenames = false;
    };
  };
}
